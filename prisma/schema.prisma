// Gitosha data model.
// Two products share one subscriber base:
//  - Build-Intel Vault: the research/scoring subscription (Subscriber + Idea)
//  - Foundry Kit: the starter-kit product (LicenseKey)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriberTier {
  FREE
  PRO
  TEAM
}

enum SubscriberStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscriber {
  id                      String           @id @default(cuid())
  email                   String           @unique
  tier                    SubscriberTier   @default(FREE)
  status                  SubscriberStatus @default(ACTIVE)
  stripeCustomerId        String?          @unique
  stripeSubscriptionId    String?          @unique
  razorpayCustomerId      String?          @unique
  razorpaySubscriptionId  String?          @unique
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([tier])
}

enum LicenseTier {
  SOLO
  PRO
  AGENCY
}

model LicenseKey {
  id                       String      @id @default(cuid())
  key                      String      @unique
  email                    String
  tier                     LicenseTier
  stripePaymentId          String?     @unique
  stripeCheckoutSessionId  String?
  razorpayPaymentId        String?     @unique
  razorpayOrderId          String?
  activatedAt              DateTime?
  downloadCount            Int         @default(0)
  lastDownloadedAt         DateTime?
  createdAt                DateTime    @default(now())

  @@index([email])
}

model Idea {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  category     String
  oneLiner     String
  scores       Json
  totalScore   Int
  isPremium    Boolean   @default(true)
  teardownMd   String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([publishedAt])
  @@index([totalScore])
}

model Issue {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summaryMd   String
  ideaIds     String[]
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

// --- Legal / privacy / consent (operator-configurable) ---

model LegalConfig {
  id          String    @id @default(cuid())
  /** Semantic version string mirrored in published documents */
  version     String
  effectiveDate DateTime
  publishedAt DateTime  @default(now())
  isActive    Boolean   @default(false)
  changeSummary String?
  /** Full LegalConfig JSON blob */
  configJson  Json
  publishedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions    LegalDocumentVersion[]

  @@index([isActive, publishedAt])
}

model LegalDocumentVersion {
  id            String   @id @default(cuid())
  legalConfigId String?
  legalConfig   LegalConfig? @relation(fields: [legalConfigId], references: [id], onDelete: SetNull)
  /** privacy | terms | cookies | … */
  slug          String
  version       String
  effectiveDate DateTime
  changeSummary String?
  /** Snapshot of rendered policy metadata / sections JSON */
  contentJson   Json
  createdAt     DateTime @default(now())
  createdBy     String?

  @@index([slug, version])
  @@index([effectiveDate])
}

model ConsentRecord {
  id           String   @id @default(cuid())
  email        String?
  anonymousId  String?
  /** ConsentPreferences JSON */
  preferences  Json
  policyVersion String
  source       String   @default("banner")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([anonymousId])
}

enum DataRightsRequestType {
  ACCESS
  CORRECT
  DELETE
  EXPORT
  WITHDRAW_CONSENT
  COMMUNICATION_PREFS
}

enum DataRightsRequestStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  NEEDS_OPERATOR
}

model DataRightsRequest {
  id          String                   @id @default(cuid())
  type        DataRightsRequestType
  status      DataRightsRequestStatus  @default(RECEIVED)
  email       String
  userId      String?
  details     String?
  /** Operator notes — never returned to requester via public API */
  operatorNote String?
  resultJson  Json?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  completedAt DateTime?

  @@index([email, createdAt])
  @@index([status])
}

model LegalAuditLog {
  id           String   @id @default(cuid())
  action       String
  actorEmail   String?
  subjectEmail String?
  detailJson   Json?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorEmail])
}

model ThirdPartyProcessor {
  id             String   @id @default(cuid())
  processorId    String   @unique
  name           String
  purpose        String
  dataCategories String[]
  policyUrl      String
  active         Boolean  @default(true)
  optional       Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

// --- Payments (provider-agnostic ledger; secrets stay in env) ---

enum PaymentTxStatus {
  pending
  requires_action
  succeeded
  failed
  canceled
  refunded
  partially_refunded
}

enum PaymentWebhookStatus {
  received
  processed
  ignored
  failed
}

enum PaymentRefundStatus {
  pending
  succeeded
  failed
}

model PaymentTransaction {
  id             String         @id @default(cuid())
  provider       String
  providerRef    String?
  userEmail      String
  planId         String
  amount         Int
  currency       String
  status         PaymentTxStatus @default(pending)
  idempotencyKey String         @unique
  /** Safe metadata only — no card data / secrets */
  metadata       Json           @default("{}")
  receiptNumber  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  refunds        PaymentRefund[]

  @@index([userEmail, createdAt])
  @@index([provider, providerRef])
  @@index([status, createdAt])
}

model PaymentWebhookEvent {
  id             String               @id @default(cuid())
  provider       String
  eventId        String
  /** Redacted summary — never store raw signed payloads with secrets */
  payloadSummary Json
  processedAt    DateTime?
  status         PaymentWebhookStatus @default(received)
  createdAt      DateTime             @default(now())

  @@unique([provider, eventId])
  @@index([status, createdAt])
}

model PaymentRefund {
  id            String              @id @default(cuid())
  transactionId String
  transaction   PaymentTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount        Int
  currency      String
  status        PaymentRefundStatus @default(pending)
  providerRef   String?
  reason        String?
  actorEmail    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([transactionId])
}

/** Public toggles only — secrets remain in environment variables. */
model PaymentProviderConfig {
  id                   String   @id @default(cuid())
  providerId           String   @unique
  enabled              Boolean  @default(false)
  /** JSON array of currency codes, e.g. ["USD","INR"] */
  supportedCurrencies  Json     @default("[\"USD\"]")
  /** Non-secret operator notes / dashboard hints */
  publicConfig         Json     @default("{}")
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}
