# Site — production MUST be the live origin (magic links / checkout redirects)
NEXT_PUBLIC_SITE_URL=https://gitosha.vercel.app
# Local only: NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Supabase Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase Auth
# Also set Site URL + Redirect URLs in the Supabase dashboard — see docs/AUTH.md
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional: for scripts/setup-supabase-auth.ts
# SUPABASE_ACCESS_TOKEN=sbp_…
# SUPABASE_PROJECT_REF=your_project_ref

# Payments — Xflow only (INR UPI). See docs/PAYMENTS.md.
# Catalog USD is converted via PLAN_PRICE_BOOK — not live FX.
XFLOW_API_KEY=
XFLOW_ACCOUNT_ID=
XFLOW_WEBHOOK_SECRET=
# Optional API host override (tests). Default https://api.xflowpay.com
# XFLOW_API_BASE=
# Optional tax on invoices (default off — do not invent tax)
# PAYMENTS_TAX_ENABLED=false
# PAYMENTS_TAX_RATE_BPS=0
# PAYMENTS_TAX_LABEL=GST
# PAYMENTS_FX_PROVIDER=none

# Email (Resend) — required for Gitosha-branded magic links
RESEND_API_KEY=
EMAIL_FROM=Gitosha <hello@yourdomain.com>
# SUPABASE_SERVICE_ROLE_KEY above + Resend = branded login emails (no “Supabase Auth” heading)

# Optional: OpenAI for Gita chat polish (grounded knowledge works without this)
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Legal / privacy operator config — do NOT invent street addresses or tax IDs
# LEGAL_ENTITY_NAME=Your registered entity name
# LEGAL_CONTACT_EMAIL=ops@yourdomain.com
# LEGAL_PRIVACY_EMAIL=privacy@yourdomain.com
# LEGAL_DPO_EMAIL=
# LEGAL_DMCA_EMAIL=
# LEGAL_ADDRESS=Registered address only when real
# LEGAL_GOVERNING_LAW=India
# LEGAL_JURISDICTION_NOTE=
# LEGAL_ENABLED_REGIONS=IN_DPDP
# LEGAL_POLICY_VERSION=1.0.0
# LEGAL_EFFECTIVE_DATE=2026-07-30
# LEGAL_LAST_UPDATED=2026-07-30
# Comma-separated Supabase session emails allowed to publish at /admin/legal (deny-by-default)
# LEGAL_ADMIN_EMAILS=you@yourdomain.com
# ADMIN_EMAILS=