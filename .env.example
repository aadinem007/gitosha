# Site — production MUST be the live origin (magic links / checkout redirects)
NEXT_PUBLIC_SITE_URL=https://gitosha.vercel.app
# Local only: NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Supabase Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase Auth
# Also set Site URL + Redirect URLs in the Supabase dashboard — see docs/AUTH.md
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional: for scripts/setup-supabase-auth.ts
# SUPABASE_ACCESS_TOKEN=sbp_…
# SUPABASE_PROJECT_REF=your_project_ref

# Payments — Razorpay is default (keeps existing Vercel keys working).
# Site catalog is USD; Razorpay charges INR via fixed configured conversion (not live FX).
# Set stripe only if you configure Stripe keys. See docs/PAYMENTS.md.
PAYMENTS_PROVIDER=razorpay
# PAYMENTS_RAZORPAY_ENABLED=true
# PAYMENTS_STRIPE_ENABLED=true
# Optional tax display (default off — do not invent tax)
# PAYMENTS_TAX_ENABLED=false
# PAYMENTS_TAX_RATE_BPS=0
# PAYMENTS_TAX_LABEL=GST

# Stripe (optional — only when PAYMENTS_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_…
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_…
STRIPE_WEBHOOK_SECRET=whsec_…
# Optional: created by `npm run setup-stripe` — checkout falls back to price_data if unset
STRIPE_PRICE_VAULT_PRO=
STRIPE_PRICE_VAULT_TEAM=
STRIPE_PRICE_VAULT_PRO_ANNUAL=
STRIPE_PRICE_FOUNDRY_SOLO=
STRIPE_PRICE_FOUNDRY_AGENCY=
STRIPE_PRICE_BUNDLE_LAUNCH=

# Razorpay (default when PAYMENTS_PROVIDER=razorpay)
RAZORPAY_KEY_ID=rzp_test_…
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_VAULT_PRO=
RAZORPAY_PLAN_VAULT_TEAM=

# Scaffold providers (disabled — do not enable without live adapters)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# XFLOW_API_KEY=
# WISE_API_TOKEN=
# PAYONEER_CLIENT_ID=

# Email (Resend) — required for Gitosha-branded magic links
RESEND_API_KEY=
EMAIL_FROM=Gitosha <hello@yourdomain.com>
# SUPABASE_SERVICE_ROLE_KEY above + Resend = branded login emails (no “Supabase Auth” heading)

# Optional: OpenAI for Gita chat polish (grounded knowledge works without this)
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Legal / privacy operator config — do NOT invent street addresses or tax IDs
# LEGAL_ENTITY_NAME=Your registered entity name
# LEGAL_CONTACT_EMAIL=ops@yourdomain.com
# LEGAL_PRIVACY_EMAIL=privacy@yourdomain.com
# LEGAL_DPO_EMAIL=
# LEGAL_DMCA_EMAIL=
# LEGAL_ADDRESS=Registered address only when real
# LEGAL_GOVERNING_LAW=India
# LEGAL_JURISDICTION_NOTE=
# LEGAL_ENABLED_REGIONS=IN_DPDP
# LEGAL_POLICY_VERSION=1.0.0
# LEGAL_EFFECTIVE_DATE=2026-07-30
# LEGAL_LAST_UPDATED=2026-07-30
# Comma-separated Supabase session emails allowed to publish at /admin/legal (deny-by-default)
# LEGAL_ADMIN_EMAILS=you@yourdomain.com
# ADMIN_EMAILS=