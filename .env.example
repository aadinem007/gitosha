# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Supabase Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Payments — Stripe is default (USD). Set PAYMENTS_PROVIDER=razorpay to use Razorpay instead.
PAYMENTS_PROVIDER=stripe

# Stripe (required when PAYMENTS_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_…
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_…
STRIPE_WEBHOOK_SECRET=whsec_…
# Optional: created by `npm run setup-stripe` — checkout falls back to price_data if unset
STRIPE_PRICE_VAULT_PRO=
STRIPE_PRICE_VAULT_TEAM=
STRIPE_PRICE_VAULT_PRO_ANNUAL=
STRIPE_PRICE_FOUNDRY_SOLO=
STRIPE_PRICE_FOUNDRY_AGENCY=
STRIPE_PRICE_BUNDLE_LAUNCH=

# Razorpay (optional / legacy — only when PAYMENTS_PROVIDER=razorpay)
RAZORPAY_KEY_ID=rzp_test_…
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_VAULT_PRO=
RAZORPAY_PLAN_VAULT_TEAM=

# Email (optional — Resend)
RESEND_API_KEY=
EMAIL_FROM=Gitosha <hello@yourdomain.com>
